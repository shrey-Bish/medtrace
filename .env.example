# Copy this file to .env and fill in the values. NEVER commit .env.

# --- Deployment (Polygon Amoy testnet) ---
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
PRIVATE_KEY=            # deployer wallet private key (use a test-only wallet)
POLYGONSCAN_API_KEY=    # optional, for `npx hardhat verify`

# --- Off-chain scripts ---
RPC_URL=http://127.0.0.1:8545   # or the Amoy RPC above
CONTRACT_ADDRESS=               # printed by scripts/deploy.js
SENSOR_PRIVATE_KEY=             # wallet with SENSOR_ROLE
PINATA_JWT=                     # IPFS pinning (Interim Demo)
